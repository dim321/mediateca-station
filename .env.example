# Plain token from Station#assign_agent_token! in the hub. Shown once.
AGENT_TOKEN=

# Hub screen id this process is willing to play. Other screens of the same
# station are logged once as no_serial and are not played.
SCREEN_ID=1

# Android TV on the television LAN 192.168.33.0/24. With
# `docker compose --profile tv up` the emulator is 192.168.33.182.
# Unreachable is fine while debugging the hub API alone.
# ADB_SERIAL=192.168.33.182:5555

# Leave unset. The entrypoint calls the hub container by its IP.
# HUB_BASE_URL=

# POLL_INTERVAL=15s
# HTTP_SECRET=dev-only-http-secret-not-for-production
